{
  "name": "1. Sync Job Orders",
  "nodes": [
    {
      "parameters": {},
      "name": "Start",
      "type": "n8n-nodes-base.start",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/15 * * * *"
            }
          ]
        }
      },
      "name": "Cron (Every 15 min)",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [250, 150]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:3000/api/v1/jobs/sync",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer ={{$env.N8N_API_KEY}}"
            }
          ]
        },
        "options": {}
      },
      "name": "Call Sync API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [450, 150]
    }
  ],
  "connections": {
    "Cron (Every 15 min)": {
      "main": [
        [
          {
            "node": "Call Sync API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "f7d5440c-15ba-411a-8260-dbce6d5523e9"
}

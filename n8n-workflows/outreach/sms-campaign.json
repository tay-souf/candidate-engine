{
  "name": "SMS Outreach Campaign",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "trigger-sms-campaign",
        "options": {}
      },
      "name": "Webhook (From Engine API)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [ 240, 300 ],
      "webhookId": "12345678-sms-trigger"
    },
    {
      "parameters": {
        "from": "={{$json.body.fromNumber}}",
        "to": "={{$json.body.toNumber}}",
        "message": "={{$json.body.messageBody}}"
      },
      "name": "Twilio (Send SMS)",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [ 480, 300 ],
      "credentials": {
        "twilioApi": {
          "id": "1",
          "name": "Twilio account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://engine-api:3000/api/webhooks/twilio/sms-status",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "MessageSid",
              "value": "={{$json.sid}}"
            },
            {
              "name": "MessageStatus",
              "value": "={{$json.status}}"
            }
          ]
        },
        "options": {}
      },
      "name": "Update Status in Engine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 700, 300 ]
    }
  ],
  "connections": {
    "Webhook (From Engine API)": {
      "main": [
        [
          {
            "node": "Twilio (Send SMS)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Twilio (Send SMS)": {
      "main": [
        [
          {
            "node": "Update Status in Engine",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}

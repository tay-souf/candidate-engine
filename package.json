    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "google-auth-library": "^9.14.0",
    "googleapis": "^144.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "node-cron": "^3.0.3",
    "openai": "^4.67.0",
    "pg": "^8.13.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "retell-sdk": "^4.0.0",
    "twilio": "^5.3.0",
